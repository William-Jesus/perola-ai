# Obrigatória
OPENAI_API_KEY=xxx

# Opcionais — nome e idade da criança, usados no prompt e na voz
PEROLA_NOME=amiga
PEROLA_IDADE=9

# Opções de voz: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse, marin, cedar
PEROLA_VOICE=coral

# Opcional — cap de duração por sessão de voz, em minutos (rede de segurança de custo)
NEXT_PUBLIC_PEROLA_MAX_MINUTOS=20
