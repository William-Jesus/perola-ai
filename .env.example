# Obrigatórias
OPENAI_API_KEY=xxx

# Código de acesso — sem ele, TODA rota da Pérola recusa a requisição.
# Fala fechada de propósito: se esquecer de configurar, o app não abre pra
# ninguém, em vez de abrir pra qualquer um. Escolha algo que não seja óbvio.
PEROLA_ACCESS_CODE=xxx

# Opcionais — nome e idade da criança, usados no prompt e na voz
PEROLA_NOME=amiga
PEROLA_IDADE=9

# Opções de voz: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse, marin, cedar
PEROLA_VOICE=coral
